# Copy this file to .env and paste your own API key locally.
# Never commit .env or share your API key.
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Initial study tickers. QQQM is your primary research object.
TICKERS=QQQM,QQQ,SPY,TLT

# DeepSeek API
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Market data
MARKET_DATA_PROVIDER=eodhd
EODHD_API_KEY=replace_with_your_eodhd_api_key

# Initial research tickers
TICKERS=QQQM,QQQ,SPY,TLT

# Will be used when the FRED macro-data module is implemented
FRED_API_KEY=replace_with_your_fred_api_key